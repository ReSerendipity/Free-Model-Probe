{"Code":200,"Data":{"AigcAttributes":"{}","AigcIsTop":0,"AigcType":"","AlreadyStar":false,"ApplyMeta":"{}","ApprovalMode":0,"ApprovalNotifyEmail":"","Architectures":["DeepseekV4ForCausalLM"],"Avatar":"https://img.alicdn.com/imgextra/i1/O1CN01yhHrHg1Pdl3UKPhGc_!!6000000001864-2-tps-88-88.png","Backbone":[],"BackendSupport":{"architectures":null,"backend_info":{"deploy_task":null,"lmdeploy":null,"lmdeploy_turbomind":null,"ollama":null,"sglang":null,"vllm":null},"model_id":"deepseek-ai/DeepSeek-V4-Flash-Vision-Exp"},"BaseModel":null,"BaseModelRelation":"","CardReady":0,"CardUnreadyReason":"","CertificationCreateBy":"","CertificationCreatedTime":-62135596800,"ChineseName":"","CoverHeight":0,"CoverImages":[],"CoverWidth":0,"CreatedBy":"systemd","CreatedTime":1788181976,"DashSdkParameter":"","Datasets":{},"DemoAvailable":0,"DemoUnavailableReason":"","Description":"","Domain":[],"Downloads":26385,"ExampleCodeAvailable":0,"ExampleCodeUnavailableReason":"","ForbiddenVisibilityUpdate":false,"Frameworks":["pytorch"],"FromSite":"github","Id":1567791,"Integrating":0,"IntegrationFailureLog":"","IntegrationFailureReason":"","IsAccessible":1,"IsCertification":4,"IsHot":0,"IsNewModel":true,"IsOnline":1,"IsPreTrain":0,"IsPublished":1,"IsTop":117,"Language":[],"LastUpdatedTime":1788264492,"Libraries":["safetensors","pytorch"],"License":"mit","LicenseLink":"","LicenseName":"","Meta":"","Metrics":[],"ModelDetail":{},"ModelInfos":{"safetensor":{"chat_template":"","files":[{"name":"model.safetensors.index.json","sha256":"507977e3d3818865264e68c0fdab139aa7f3929d0d0cf693dacc47428da56395","size":5625861},{"name":"model-00001-of-00048.safetensors","sha256":"367c971dc3cd6a042a9bec1caff508e77eabfaef1df2de3a827397ef8bbc6af3","size":1991876272},{"name":"model-00002-of-00048.safetensors","sha256":"b7bca4e9f4ad1cbd7ae204ba8f452450473efe780ba5e539f9b478a7746ee913","size":3566323424},{"name":"model-00003-of-00048.safetensors","sha256":"533065ef725b1b85ea6bea54a4b791caa7ea37ca8bf40edb892f1df53d922852"