,"gated":false},{"id":"fyg0518/Ltx2.3-Licon-VBVR-I2V-390K-R32","display_name":"Ltx2.3-Licon-VBVR-I2V-390K-R32","description":"这是一个用于 Lightricks LTX‑2.3（22B） 的图生视频（I2V）专用 LoRA，主打视频物理与逻辑推理，由 LiconStudio 训练在 LTX‑2.3 原生 I2V 基础上，显著增强：1、物理合理性：物体运动更自然（加速 / 减速 / 碰撞 / 重力），减少 “滑步、悬浮、穿墙”。2、时空一致性：人物 / 物体外观、光照、视角更稳定，闪烁、跳变、伪影更少。3、复杂提示理解：多物体、多条件、空间关系、时间顺序的指令更准。4、运动多样性：减少 “静态 + 轻微缩放”（Ken Burns），生成真实动态。5、相机稳定：减少无规律抖动、跳视角。","downloads":971,"likes":6,"license":"Apache License 2.0","tasks":[],"created_at":"2026-05-22T06:09:58Z","last_modified":"2026-05-22T06:10:12Z","file_size":554010181,"params":276824064,"tags":["license:Apache License 2.0","library:lora","library:safetensors","library:pytorch","custom_tag:LoRA"],"private":false,"gated":false},{"id":"Qwen/Qwen3Guard-Gen-8B","display_name":"Qwen3Guard-Gen-8B","description":"","downloads":12640,"likes":18,"license":"apache-2.0","tasks":["text-generation"],"created_at":"2025-09-23T11:17:09Z","last_modified":"2025-11-07T16:52:37Z","file_size":16397455085,"params":8190735360,"tags":["license:apache-2.0","model_type:qwen3","library:transformer","library:safetensors","library:pytorch","task:text-generation","deploy:swingdeploy"],"private":false,"gated":false},{"id":"ZhipuAI/GLM-5.1-FP8","display_name":"GLM-5.1-FP8","description":"","downloads":48798,"likes":27,"license":"mit","tasks":["text-generation"],"created_at":"2026-04-04T15:14:19Z","last_modified":"2026-04-16T13:21:23Z","file_size":756209324619,"params":753910024032,"tags":["license:mit","model_type:glm_moe_dsa","library:safetensors","library:pytorch","task:text-generation"],"private":false,"gated":false},{"id":"iohjiuj555/Krea2-azx-test","display_name":"Krea2 An Ji-Hyun","description":"","downloads":130,"likes":8,"license":"Apache License 2.0","tasks":["text-to-image-synthesis"],"created_at":"2026-07-02T01:55:12Z","last_modified":"2026-07-02T07:04:52Z","file_size":1408087969,"params":703834560,"tags":["license:Apache License 2.0","library:pytorch","library:lora","library:safetensors